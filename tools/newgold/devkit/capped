#!/bin/sh
# Run a command in its own memory-capped scope: if it grows past the cap the
# kernel kills it alone, not the PC and not Claude (a harness walk once grew to
# 12 GB per copy and took the whole session down, 2026-09-24).
#     capped [-m 4G] COMMAND...      (default cap 4G, no swap past 1G)
MEM=4G
if [ "$1" = "-m" ]; then MEM=$2; shift 2; fi
if [ $# = 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then sed -n 's/^#     //p' "$0"; exit 2; fi
exec systemd-run --user --scope -q -p MemoryMax="$MEM" -p MemorySwapMax=1G -- "$@"
