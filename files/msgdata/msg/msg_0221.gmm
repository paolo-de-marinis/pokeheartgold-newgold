	<row id="msg_0221_01097" index="1097">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A letter of recommendation that you’ll\nneed in order to participate in the\nGym Challenge.</language>
	</row>
	<row id="msg_0221_01098" index="1098">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A device that allows you to access the\nPokémon storage system. There are some\nplaces where it won’t work.</language>
	</row>
	<row id="msg_0221_01099" index="1099">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A stone found in the Galar region with\na mysterious power. It’s said that your\ndreams come true if you find one.</language>
	</row>
	<row id="msg_0221_01100" index="1100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A Wishing Star has been affixed to it.\nIt lets out a light that allows Pokémon\nto Dynamax when at a Power Spot.</language>
	</row>
	<row id="msg_0221_01101" index="1101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">- - -</language>
	</row>
