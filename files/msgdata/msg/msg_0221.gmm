<?xml version="1.0"?>
<body language="English">
	<row id="msg_0221_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">???</language>
	</row>
	<row id="msg_0221_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The best Poké Ball with the ultimate\nlevel of performance. With it, you will\ncatch any wild Pokémon without fail.</language>
	</row>
	<row id="msg_0221_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An ultra-high-performance Poké Ball\nthat provides a higher success rate\nfor catching Pokémon than a Great Ball.</language>
	</row>
	<row id="msg_0221_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A good, high-performance Poké Ball that\nprovides a higher Pokémon catch rate\nthan a standard Poké Ball.</language>
	</row>
	<row id="msg_0221_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A device for catching wild Pokémon.\nIt’s thrown like a ball at a Pokémon,\ncomfortably encapsulating its target.</language>
	</row>
	<row id="msg_0221_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A special Poké Ball that was used in the\nSafari Zone in the Kanto region and in\nthe Great Marsh in the Sinnoh region.</language>
	</row>
	<row id="msg_0221_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nis more effective when catching\nWater- or Bug-type Pokémon.</language>
	</row>
	<row id="msg_0221_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nis more effective when catching\nPokémon in or on the water.</language>
	</row>
	<row id="msg_0221_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nbecomes more effective the lower the\nlevel of the wild Pokémon.</language>
	</row>
	<row id="msg_0221_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nworks especially well on a Pokémon\nspecies that has been caught before.</language>
	</row>
	<row id="msg_0221_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nbecomes progressively better the\nmore turns there are in a battle.</language>
	</row>
	<row id="msg_0221_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A particularly comfortable Poké Ball\nthat makes a wild Pokémon quickly\ngrow friendlier after being caught.</language>
	</row>
	<row id="msg_0221_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat rare Poké Ball made to\ncommemorate a special occasion\nof some sort.</language>
	</row>
	<row id="msg_0221_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that is\nmore effective when catching Pokémon\nat night or in dark places like caves.</language>
	</row>
	<row id="msg_0221_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A remedial Poké Ball that restores\nHP and eliminates status conditions\nfor a Pokémon caught with it.</language>
	</row>
	<row id="msg_0221_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nis more effective at catching Pokémon\nwhen used first thing in a battle.</language>
	</row>
	<row id="msg_0221_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A quite rare Poké Ball made to\ncommemorate a special occasion of\nsome sort.</language>
	</row>
	<row id="msg_0221_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for treating\nwounds. It can be used to restore\n20 HP to a Pokémon.</language>
	</row>
	<row id="msg_0221_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for poisoning.\nIt can be used once to lift the effects\nof being poisoned from a Pokémon.</language>
	</row>
	<row id="msg_0221_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for treating\nburns. It can be used to cure a\nPokémon suffering from a burn.</language>
	</row>
	<row id="msg_0221_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for treating\nfreezing. It can be used to thaw out\na Pokémon that has been frozen solid.</language>
	</row>
	<row id="msg_0221_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine to wake the\nsleeping. It can be used to rouse a\nPokémon from the clutches of sleep.</language>
	</row>
	<row id="msg_0221_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for treating\nparalysis. It can be used to free a\nPokémon that has been paralyzed.</language>
	</row>
	<row id="msg_0221_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that can be used to fully\nrestore the max HP of a Pokémon and\ncure any status conditions it may have.</language>
	</row>
	<row id="msg_0221_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for treating\nwounds. It can be used to fully\nrestore the max HP of a Pokémon.</language>
	</row>
	<row id="msg_0221_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for treating\nwounds. It can be used to restore\n200 HP to a Pokémon.</language>
	</row>
	<row id="msg_0221_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for treating\nwounds. It can be used to restore\n50 HP to a Pokémon.</language>
	</row>
	<row id="msg_0221_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine that is broadly\neffective. It can be used to cure any\nstatus condition a Pokémon may have.</language>
	</row>
	<row id="msg_0221_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that can be used to revive\na Pokémon that has fainted. It also\nrestores half the Pokémon’s max HP.</language>
	</row>
	<row id="msg_0221_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that can be used to revive\na Pokémon that has fainted. It also\nfully restores the Pokémon’s max HP.</language>
	</row>
	<row id="msg_0221_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Water with high mineral content.\nIt can be used to restore 30 HP\nto a Pokémon.</language>
	</row>
	<row id="msg_0221_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A highly carbonated soda drink.\nIt can be used to restore 50 HP\nto a Pokémon.</language>
	</row>
	<row id="msg_0221_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A very sweet and refreshing drink.\nIt can be used to restore 70 HP\nto a Pokémon.</language>
	</row>
	<row id="msg_0221_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A bottle of highly nutritious milk.\nIt can be used to restore 100 HP\nto a Pokémon.</language>
	</row>
	<row id="msg_0221_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A very bitter medicinal powder.\nIt can be used to restore 60 HP\nto a Pokémon.</language>
	</row>
	<row id="msg_0221_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A very bitter medicinal root.\nIt can be used to restore 120 HP\nto a Pokémon.</language>
	</row>
	<row id="msg_0221_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A very bitter medicinal powder.\nIt can be used to cure any status\ncondition a Pokémon may have.</language>
	</row>
	<row id="msg_0221_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A terribly bitter medicinal herb.\nIt revives a fainted Pokémon\nand fully restores its max HP.</language>
	</row>
	<row id="msg_0221_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that can be used to\nrestore 10 PP to a single move\nthat a Pokémon knows.</language>
	</row>
	<row id="msg_0221_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that can be used to fully\nrestore the max PP of a single move\nthat a Pokémon knows.</language>
	</row>
	<row id="msg_0221_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that can be used to\nrestore 10 PP to all four moves\nthat a Pokémon knows.</language>
	</row>
	<row id="msg_0221_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that can be used to fully\nrestore the max PP of all four moves\nthat a Pokémon knows.</language>
	</row>
	<row id="msg_0221_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lavaridge Town’s local specialty.\nIt can be used to cure any status\ncondition a Pokémon may have.</language>
	</row>
	<row id="msg_0221_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A 100 percent pure juice made from\nBerries. It can be used to restore\n20 HP to a Pokémon.</language>
	</row>
	<row id="msg_0221_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ash that can be used to revive all party\nPokémon that have fainted. It also fully\nrestores the Pokémon’s max HP.</language>
	</row>
	<row id="msg_0221_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A nutritious drink for Pokémon.\nThis drink increases base points\nfor a Pokémon’s HP stat.</language>
	</row>
	<row id="msg_0221_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A nutritious drink for Pokémon.\nThis drink increases base points\nfor a Pokémon’s Attack stat.</language>
	</row>
	<row id="msg_0221_00047" index="47">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A nutritious drink for Pokémon.\nThis drink increases base points\nfor a Pokémon’s Defense stat.</language>
	</row>
	<row id="msg_0221_00048" index="48">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A nutritious drink for Pokémon.\nThis drink increases base points\nfor a Pokémon’s Speed stat.</language>
	</row>
	<row id="msg_0221_00049" index="49">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A nutritious drink for Pokémon.\nThis drink increases base points\nfor a Pokémon’s Sp. Atk stat.</language>
	</row>
	<row id="msg_0221_00050" index="50">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A candy that is packed with energy.\nIf consumed, it raises a Pokémon’s\nlevel by one.</language>
	</row>
	<row id="msg_0221_00051" index="51">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that can be used to slightly\nraise the max PP of a single move that\na Pokémon knows.</language>
	</row>
	<row id="msg_0221_00052" index="52">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A nutritious drink for Pokémon.\nThis drink increases base points\nfor a Pokémon’s Sp. Def stat.</language>
	</row>
	<row id="msg_0221_00053" index="53">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that can be used to raise the\nmax PP of a single move that a Pokémon\nknows as high as it can possibly go.</language>
	</row>
	<row id="msg_0221_00054" index="54">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A hidden gem found in the Old Chateau.\nIt can be used to cure any status\ncondition a Pokémon may have.</language>
	</row>
	<row id="msg_0221_00055" index="55">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that prevents Pokémon on\nyour side from having their stats\nlowered in battle for five turns.</language>
	</row>
	<row id="msg_0221_00056" index="56">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that raises the critical-hit\nratio. It can be used only once and\nwears off if the Pokémon is withdrawn.</language>
	</row>
	<row id="msg_0221_00057" index="57">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that boosts the Attack stat of\na Pokémon during battle. It wears off\nonce the Pokémon is withdrawn.</language>
	</row>
	<row id="msg_0221_00058" index="58">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that boosts the Defense stat of\na Pokémon during battle. It wears off\nonce the Pokémon is withdrawn.</language>
	</row>
	<row id="msg_0221_00059" index="59">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that boosts the Speed stat of\na Pokémon during battle. It wears off\nonce the Pokémon is withdrawn.</language>
	</row>
	<row id="msg_0221_00060" index="60">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that boosts the Accuracy stat of\na Pokémon during battle. It wears off\nonce the Pokémon is withdrawn.</language>
	</row>
	<row id="msg_0221_00061" index="61">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that boosts the Sp. Atk stat of\na Pokémon during battle. It wears off\nonce the Pokémon is withdrawn.</language>
	</row>
	<row id="msg_0221_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that boosts the Sp. Def stat of\na Pokémon during battle. It wears off\nonce the Pokémon is withdrawn.</language>
	</row>
	<row id="msg_0221_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A doll that attracts the attention\nof Pokémon. It guarantees escape\nfrom any battle with wild Pokémon.</language>
	</row>
	<row id="msg_0221_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A toy that attracts the attention of\nPokémon. It guarantees escape from\nany battle with wild Pokémon.</language>
	</row>
	<row id="msg_0221_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A flute made from blue glass.\nIt awakens sleeping Pokémon.</language>
	</row>
	<row id="msg_0221_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A flute made from yellow glass.\nIt snaps Pokémon out of confusion.</language>
	</row>
	<row id="msg_0221_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A flute made from red glass.\nIt snaps Pokémon out of infatuation.</language>
	</row>
	<row id="msg_0221_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A flute made from black glass.\nIt makes it easier to encounter high-level\nPokémon in the place you use it.</language>
	</row>
	<row id="msg_0221_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A flute made from white glass.\nIt makes it easier to encounter low-level\nPokémon in the place you use it.</language>
	</row>
	<row id="msg_0221_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Salt that was found inside Shoal Cave.</language>
	</row>
	<row id="msg_0221_00071" index="71">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A seashell that was found inside\nShoal Cave.</language>
	</row>
	<row id="msg_0221_00072" index="72">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A small red shard.\nIt appears to be a fragment of some\nsort of implement made long ago.</language>
	</row>
	<row id="msg_0221_00073" index="73">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A small blue shard.\nIt appears to be a fragment of some\nsort of implement made long ago.</language>
	</row>
	<row id="msg_0221_00074" index="74">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A small yellow shard.\nIt appears to be a fragment of some\nsort of implement made long ago.</language>
	</row>
	<row id="msg_0221_00075" index="75">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A small green shard.\nIt appears to be a fragment of some\nsort of implement made long ago.</language>
	</row>
	<row id="msg_0221_00076" index="76">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that prevents low-level wild\nPokémon from jumping out at you for a time.\nIt lasts longer than Repel.</language>
	</row>
	<row id="msg_0221_00077" index="77">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that prevents low-level wild\nPokémon from jumping out at you for a time.\nIt lasts longer than Super Repel.</language>
	</row>
	<row id="msg_0221_00078" index="78">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A long and durable rope.\nUse it to escape instantly from\nlocations like caves or dungeons.</language>
	</row>
	<row id="msg_0221_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that prevents low-level wild\nPokémon from jumping out at you for\na short time.</language>
	</row>
	<row id="msg_0221_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar stone that can make\ncertain species of Pokémon evolve.\nIt burns as red as the evening sun.</language>
	</row>
	<row id="msg_0221_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar stone that can make\ncertain species of Pokémon evolve.\nIt is dark like the night sky.</language>
	</row>
	<row id="msg_0221_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar stone that can make\ncertain species of Pokémon evolve.\nIt has a fiery orange heart.</language>
	</row>
	<row id="msg_0221_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar stone that can make\ncertain species of Pokémon evolve.\nIt has a distinct thunderbolt pattern.</language>
	</row>
	<row id="msg_0221_00084" index="84">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar stone that can make\ncertain species of Pokémon evolve.\nIt is the clear blue of a deep pool.</language>
	</row>
	<row id="msg_0221_00085" index="85">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar stone that can make\ncertain species of Pokémon evolve.\nIt has an unmistakable leaf pattern.</language>
	</row>
	<row id="msg_0221_00086" index="86">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A small and rare mushroom.\nIt’s quite popular with a\ncertain class of collectors.</language>
	</row>
	<row id="msg_0221_00087" index="87">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A large and rare mushroom.\nIt’s extremely popular with a\ncertain class of collectors.</language>
	</row>
	<row id="msg_0221_00088" index="88">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A rather small pearl that has a nice\nsilvery sheen to it.\nIt can be sold at a low price to shops.</language>
	</row>
	<row id="msg_0221_00089" index="89">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A rather large pearl that has a nice\nsilvery sheen to it.\nIt can be sold at a high price to shops.</language>
	</row>
	<row id="msg_0221_00090" index="90">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lovely red sand that flows between\nthe fingers with a loose, silky feel.\nIt can be sold at a low price to shops.</language>
	</row>
	<row id="msg_0221_00091" index="91">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A small shard of a beautiful gem\nthat gives off a distinctly red sparkle.\nIt can be sold at a high price to shops.</language>
	</row>
	<row id="msg_0221_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A nugget of pure gold that gives off\na lustrous gleam.\nIt can be sold at a high price to shops.</language>
	</row>
	<row id="msg_0221_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A pretty, heart-shaped scale that is\nextremely rare. Certain people are\ndelighted to be given one of these.</language>
	</row>
	<row id="msg_0221_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Honey collected thanks to Pokémon’s\nefforts. It has a sweet aroma and\ncan be sold at a low price to shops.</language>
	</row>
	<row id="msg_0221_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A fertilizer to be spread on soft soil.\nIt speeds up the growth of Berries.\nHowever, it also dries the soil faster.</language>
	</row>
	<row id="msg_0221_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A fertilizer to be spread on soft soil.\nIt slows the growth of Berries and\ncauses the soil to dry slower.</language>
	</row>
	<row id="msg_0221_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A fertilizer to be spread on soft soil.\nIt extends the time ripened Berries\nremain on their plants before falling.</language>
	</row>
	<row id="msg_0221_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A fertilizer to be spread on soft soil.\nIt ups the number of times new plants\ngrow where mature plants withered.</language>
	</row>
	<row id="msg_0221_00099" index="99">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A fossil from a prehistoric Pokémon\nthat once lived in the sea.\nIt appears to be part of a plant’s root.</language>
	</row>
	<row id="msg_0221_00100" index="100">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A fossil from a prehistoric Pokémon\nthat once lived in the sea.\nIt appears to be a fragment of a claw.</language>
	</row>
	<row id="msg_0221_00101" index="101">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A fossil from a prehistoric Pokémon\nthat once lived in the sea.\nIt might be a piece of a seashell.</language>
