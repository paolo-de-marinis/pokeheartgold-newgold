	<row id="msg_0221_00532" index="532">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A shiny green orb that is said to have\na legend and has a deep connection with\nthe Hoenn region.</language>
	</row>
	<row id="msg_0221_00533" index="533">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A sturdy Capsule that can only be\nopened with a special key.</language>
