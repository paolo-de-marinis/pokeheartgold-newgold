	<row id="msg_0221_02336" index="2336">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A tablecloth made in collaboration\nwith a popular picture-book\nauthor.\rThe gently drawn Pokémon make\neven the loveliest picnic table\nmore charming.</language>
	</row>
	<row id="msg_0221_02337" index="2337">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A botanically themed tablecloth featuring\nGrass-type Pokémon. Can you find the\nPokémon that doesn’t quite fit in?</language>
	</row>
	<row id="msg_0221_02338" index="2338">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A pop-art-style tablecloth with\nPokémon faces floating up from\nthe deep nighttime blue.\rThis is a must-have for fans of\nGhost types.</language>
	</row>
