	<row id="msg_0221_00062" index="62">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that raises the Sp. Def stat\nof a Pokémon in battle. It wears off if\nthe Pokémon is withdrawn.</language>
	</row>
	<row id="msg_0221_00063" index="63">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A doll that attracts Pokémon.\nUse it to flee from any battle with a\nwild Pokémon.</language>
	</row>
	<row id="msg_0221_00064" index="64">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that attracts Pokémon.\nUse it to flee from any battle with a\nwild Pokémon.</language>
	</row>
	<row id="msg_0221_00065" index="65">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A blue flute made from blown glass.\nIts melody awakens a single Pokémon\nfrom sleep.</language>
	</row>
	<row id="msg_0221_00066" index="66">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A yellow flute made from blown glass.\nIts melody snaps a single Pokémon out\nof confusion.</language>
	</row>
	<row id="msg_0221_00067" index="67">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A red flute made from blown glass.\nIts melody snaps a single Pokémon out\nof infatuation.</language>
	</row>
	<row id="msg_0221_00068" index="68">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A black flute made from blown glass.\nIts melody makes wild Pokémon less\nlikely to appear.</language>
	</row>
	<row id="msg_0221_00069" index="69">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A white flute made from blown glass.\nIts melody makes wild Pokémon more\nlikely to appear.</language>
	</row>
	<row id="msg_0221_00070" index="70">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Pure salt that was discovered deep\ninside the Shoal Cave.\nIt is extremely salty.</language>
