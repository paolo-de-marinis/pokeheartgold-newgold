	<row id="msg_0221_00546" index="546">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar set of armor that can make\na certain species of Pokémon evolve.\nAuspicious wishes live within it.</language>
	</row>
	<row id="msg_0221_00547" index="547">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A teapot that can make a certain species\nof Pokémon evolve. It may be chipped,\nbut tea poured from it is delicious.</language>
	</row>
	<row id="msg_0221_00548" index="548">
