	<row id="msg_0221_00079" index="79">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An item that prevents weak wild\nPokémon from appearing for 100 steps\nafter its use.</language>
	</row>
	<row id="msg_0221_00080" index="80">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar stone that makes certain\nspecies of Pokémon evolve.\nIt is as red as the sun.</language>
	</row>
	<row id="msg_0221_00081" index="81">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar stone that makes certain\nspecies of Pokémon evolve.\nIt is as black as the night sky.</language>
	</row>
	<row id="msg_0221_00082" index="82">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar stone that makes certain\nspecies of Pokémon evolve.\nIt is colored orange.</language>
	</row>
	<row id="msg_0221_00083" index="83">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A peculiar stone that makes certain\nspecies of Pokémon evolve.\nIt has a thunderbolt pattern.</language>
	</row>
	<row id="msg_0221_00084" index="84">
		<attribute name="window_context_name">used</attribute>
