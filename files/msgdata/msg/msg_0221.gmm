		<attribute name="window_context_name">used</attribute>
		<language name="English">- - -</language>
	</row>
	<row id="msg_0221_01103" index="1103">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Use it by the water to fish up\nvarious kinds of Pokémon.</language>
	</row>
	<row id="msg_0221_01104" index="1104">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This bike can be combined with the\nPokémon Rotom to use a turbo boost.</language>
	</row>
	<row id="msg_0221_01105" index="1105">
		<attribute name="window_context_name">used</attribute>
		<language name="English">- - -</language>
	</row>
