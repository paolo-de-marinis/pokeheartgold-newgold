<?xml version="1.0"?>
<body language="English">
	<row id="msg_0221_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">???</language>
	</row>
	<row id="msg_0221_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The best Ball with the ultimate level of\nperformance. It will catch any wild\nPokémon without fail.</language>
	</row>
	<row id="msg_0221_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An ultra-performance Ball that\nprovides a higher Pokémon catch rate\nthan a Great Ball.</language>
	</row>
	<row id="msg_0221_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A good, high-performance Ball that\nprovides a higher Pokémon catch rate\nthan a standard Poké Ball.</language>
	</row>
	<row id="msg_0221_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A device for catching wild Pokémon.\nIt is thrown like a ball at the target.\nIt is designed as a capsule system.</language>
	</row>
	<row id="msg_0221_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A special Poké Ball that is used only in\nthe Great Marsh. It is decorated in a\ncamouflage pattern.</language>
	</row>
	<row id="msg_0221_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nworks especially well on Water- and\nBug-type Pokémon.</language>
	</row>
	<row id="msg_0221_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nworks especially well on Pokémon that\nlive in the sea.</language>
	</row>
	<row id="msg_0221_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nworks especially well on weaker\nPokémon in the wild.</language>
	</row>
	<row id="msg_0221_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nworks especially well on Pokémon\nspecies that were previously caught.</language>
	</row>
	<row id="msg_0221_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Ball that\nbecomes progressively better the\nmore turns there are in a battle.</language>
	</row>
	<row id="msg_0221_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A comfortable Poké Ball that makes a\ncaught wild Pokémon quickly grow\nfriendly.</language>
	</row>
	<row id="msg_0221_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat rare Poké Ball that has\nbeen specially made to commemorate\nan event of some sort.</language>
	</row>
	<row id="msg_0221_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nmakes it easier to catch wild Pokémon\nat night or in dark places like caves.</language>
	</row>
	<row id="msg_0221_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A remedial Poké Ball that restores the\ncaught Pokémon’s HP and eliminates\nany status problem.</language>
	</row>
	<row id="msg_0221_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A somewhat different Poké Ball that\nprovides a better catch rate if it is\nused at the start of a wild encounter.</language>
	</row>
	<row id="msg_0221_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A quite rare Poké Ball that has been\nspecially crafted to commemorate\nan occasion of some sort.</language>
	</row>
	<row id="msg_0221_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for wounds.\nIt restores the HP of one Pokémon by\njust 20 points.</language>
	</row>
	<row id="msg_0221_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine.\nIt lifts the effect of poison from one\nPokémon.</language>
	</row>
	<row id="msg_0221_00019" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine.\nIt heals a single Pokémon that is\nsuffering from a burn.</language>
	</row>
	<row id="msg_0221_00020" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine.\nIt defrosts a Pokémon that has been\nfrozen solid.</language>
	</row>
	<row id="msg_0221_00021" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine.\nIt awakens a Pokémon from the\nclutches of sleep.</language>
	</row>
	<row id="msg_0221_00022" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine.\nIt eliminates paralysis from a single\nPokémon.</language>
	</row>
	<row id="msg_0221_00023" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that fully restores the HP\nand heals any status problems of a\nsingle Pokémon.</language>
	</row>
	<row id="msg_0221_00024" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for wounds.\nIt completely restores the HP of a\nsingle Pokémon.</language>
	</row>
	<row id="msg_0221_00025" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for wounds.\nIt restores the HP of one Pokémon by\n200 points.</language>
	</row>
	<row id="msg_0221_00026" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine for wounds.\nIt restores the HP of one Pokémon by\n50 points.</language>
	</row>
	<row id="msg_0221_00027" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A spray-type medicine.\nIt heals all the status problems of a\nsingle Pokémon.</language>
	</row>
	<row id="msg_0221_00028" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that revives a fainted\nPokémon. It restores half the\nPokémon’s maximum HP.</language>
	</row>
	<row id="msg_0221_00029" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A medicine that revives a fainted\nPokémon. It fully restores the\nPokémon’s HP.</language>
	</row>
	<row id="msg_0221_00030" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Water with a high mineral content.\nIt restores the HP of one Pokémon by\n50 points.</language>
	</row>
	<row id="msg_0221_00031" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A fizzy soda drink.\nIt restores the HP of one Pokémon by\n60 points.</language>
	</row>
	<row id="msg_0221_00032" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A very sweet drink.\nIt restores the HP of one Pokémon by\n80 points.</language>
	</row>
	<row id="msg_0221_00033" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Milk with a very high nutrition content.\nIt restores the HP of one Pokémon by\n100 points.</language>
	</row>
	<row id="msg_0221_00034" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A very bitter medicine powder.\nIt restores the HP of one Pokémon by\n50 points.</language>
	</row>
	<row id="msg_0221_00035" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A very bitter root.\nIt restores the HP of one Pokémon by\n200 points.</language>
	</row>
	<row id="msg_0221_00036" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A very bitter medicine powder.\nIt heals all the status problems of a\nsingle Pokémon.</language>
	</row>
	<row id="msg_0221_00037" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A very bitter medicinal herb.\nIt revives a fainted Pokémon, fully\nrestoring its HP.</language>
	</row>
	<row id="msg_0221_00038" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It restores the PP of a Pokémon’s\nselected move by a maximum of\n10 points.</language>
	</row>
	<row id="msg_0221_00039" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It fully restores the PP of a single\nselected move that has been learned\nby the target Pokémon.</language>
	</row>
	<row id="msg_0221_00040" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It restores the PP of all the\nmoves learned by the targeted Pokémon\nby 10 points each.</language>
	</row>
	<row id="msg_0221_00041" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It fully restores the PP of all the\nmoves learned by the targeted\nPokémon.</language>
	</row>
	<row id="msg_0221_00042" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lavaridge Town’s local specialty.\nIt heals all the status problems of\none Pokémon.</language>
	</row>
	<row id="msg_0221_00043" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A 100% pure juice made of Berries.\nIt restores the HP of one Pokémon by\njust 20 points.</language>
	</row>
	<row id="msg_0221_00044" index="44">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It revives all fainted Pokémon.\nIn doing so, it also fully restores\ntheir HP.</language>
	</row>
	<row id="msg_0221_00045" index="45">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A nutritious drink for Pokémon.\nIt raises the base HP of a single\nPokémon.</language>
	</row>
	<row id="msg_0221_00046" index="46">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A nutritious drink for Pokémon.\nIt raises the base Attack stat of a\nsingle Pokémon.</language>
