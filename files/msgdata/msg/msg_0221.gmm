	<row id="msg_0221_01785" index="1785">
		<attribute name="window_context_name">used</attribute>
		<language name="English">A singular and irreplicable Poké Ball\nthat can be used to catch the frenzied\nPokémon raging at the Temple of Sinnoh.</language>
	</row>
