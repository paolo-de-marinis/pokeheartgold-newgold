<?xml version="1.0"?>
<body language="English">
	<row id="msg_0552_T21PC0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s great. I can store any number\nof Pokémon, and it’s all free.</language>
	</row>
	<row id="msg_0552_T21PC0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">That PC is free for any Trainer to use.</language>
	</row>
	<row id="msg_0552_T21PC0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Communication Center upstairs\nwas just built.\rBut they’re still finishing it up.</language>
	</row>
	<row id="msg_0552_T21PC0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The Communication Center upstairs\nwas just built.\rI traded Pokémon there already!</language>
	</row>
	<row id="msg_0552_T21PC0101_00004" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the Pokémon Wireless\nClub Union Room.\r...Oh, I was just trying to learn that\nline by heart.\rIt’ll take a little longer before\nwe open the Union Room.</language>
	</row>
	<row id="msg_0552_T21PC0101_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Welcome to the Pokémon\nCommunication Club Colosseum.\r...Oh, I was just trying to learn that\nline by heart.\rIt’ll take a little longer before\nwe open the Colosseum.</language>
	</row>
	<row id="msg_0552_T21PC0101_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Hi! I’m a Pokémon trainer of a\nspecial kind.\rI can set a Pokémon’s EVs for you,\nby hand or from one of my sets.\rI can also Hyper train it with\nBottle Caps, once it reaches Lv. 50.\rWhat would you like to do?</language>
	</row>
	<row id="msg_0552_T21PC0101_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Train a Pokémon</language>
	</row>
	<row id="msg_0552_T21PC0101_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Buy Mochi and Caps</language>
	</row>
	<row id="msg_0552_T21PC0101_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cancel</language>
	</row>
	<row id="msg_0552_T21PC0101_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Mochi raise EVs, and Bottle Caps are\nfor Hyper Training. Have a look!</language>
	</row>
	<row id="msg_0552_T21PC0101_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Come back anytime!</language>
	</row>
	<row id="msg_0552_T21PC0101_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your Pokémon will thank you.\nCome back anytime!</language>
	</row>
</body>
