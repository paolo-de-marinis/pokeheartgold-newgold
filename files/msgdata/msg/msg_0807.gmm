	<row id="msg_0807_furfrou_heart" index="1216">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Historically, in the Kalos region,\nthese Pokémon were the designated\nguardians of the king.</language>
	</row>
	<row id="msg_0807_furfrou_star" index="1217">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Historically, in the Kalos region,\nthese Pokémon were the designated\nguardians of the king.</language>
	</row>
	<row id="msg_0807_furfrou_diamond" index="1218">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Historically, in the Kalos region,\nthese Pokémon were the designated\nguardians of the king.</language>
	</row>
