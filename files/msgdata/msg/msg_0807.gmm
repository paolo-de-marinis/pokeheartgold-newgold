		<attribute name="window_context_name">used</attribute>
		<language name="English">This Pokémon existed 300 million years ago.\nTeam Plasma altered it and attached\na cannon to its back.</language>
	</row>
	<row id="msg_0807_genesect_chill_drive" index="1181">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This Pokémon existed 300 million years ago.\nTeam Plasma altered it and attached\na cannon to its back.</language>
	</row>
	<row id="msg_0807_greninja_battle_bond" index="1182">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It creates throwing stars out of\ncompressed water, that can split metal\nin two.</language>
	</row>
	<row id="msg_0807_greninja_ash" index="1183">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It creates throwing stars out of\ncompressed water, that can split metal\nin two.</language>
	</row>
