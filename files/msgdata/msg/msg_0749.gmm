	<row id="msg_0749_00157" index="157">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Large boulders are\nhurled at the foe to\ninflict damage.\nIt may also make the\ntarget flinch.</language>
	</row>
	<row id="msg_0749_00158" index="158">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The user bites hard\non the foe with its\nsharp front fangs.\nIt may also make the\ntarget flinch.</language>
	</row>
	<row id="msg_0749_00159" index="159">
